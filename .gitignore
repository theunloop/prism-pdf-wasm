# Build output. Both are generated by `npm run build` and shipped in the npm tarball, never
# committed: `pkg/` is wasm-pack's output and `dist/` is tsc's.
/pkg/
/dist/
/target/
/node_modules/

# The shared conformance corpus is the engine's, fetched per tag by build/fetch-corpus.sh.
# Forking it here is what docs/conformance-suite.md exists to forbid.
/corpus/

# Written by build/build-wasm.sh --core to patch in a local engine checkout. Machine-specific,
# and committing it would silently build the package against someone's working tree.
/.cargo/config.toml

*.tgz
.DS_Store

# The demo site, assembled by build/build-demo.sh from dist/, pkg/ and — for the preview tab
# alone — node_modules/pdfjs-dist. All three are build output; none of it is committed.
/_site/
