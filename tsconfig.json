{
  "compilerOptions": {
    // ES2022 for `#private` fields; the explicit-resource-management types (`Symbol.dispose`,
    // which `using` compiles against) live in the esnext.disposable lib.
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
